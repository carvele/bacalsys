# Copy to .env.local (git-ignored) and fill from `supabase status` after `supabase start`.
# Local defaults: API URL is http://127.0.0.1:54321.
# Android emulator: use http://10.0.2.2:54321. Physical device: use your machine's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
