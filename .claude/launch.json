{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-hosted",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env.hosted.local",
        "node_modules/expo/bin/cli",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/web/serve.mjs",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "web-pages",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/web/serve.mjs",
        "4174",
        "/bacalsys"
      ],
      "port": 4174
    }
  ]
}
